{
  "name": "labs",
  "private": true,
  "type": "module",
  "description": "Forks and the crates Bun takes in, purged, patched, deduplicated and tuned in one Cargo workspace",
  "scripts": {
    "sync": "bun scripts/sync.ts",
    "unify": "bun scripts/unify.ts",
    "remote": "bun scripts/remote.ts",
    "bench": "bun scripts/bench.ts",
    "check": "cargo check",
    "dupes": "cargo tree --workspace -d -e normal,build --depth 0",
    "deny": "cargo deny check bans sources",
    "port": "bun scripts/port.ts",
    "deps": "bun scripts/deps.ts",
    "bump": "bun scripts/bump.ts",
    "lint": "bun lint --no-script scripts",
    "fmt": "bun fmt --no-script scripts package.json tsconfig.json",
    "typecheck": "bun check --no-script",
    "clippy": "cargo clippy --workspace --all-targets -- -D warnings"
  },
  "devDependencies": {
    "@types/bun": "1.4.5"
  }
}
