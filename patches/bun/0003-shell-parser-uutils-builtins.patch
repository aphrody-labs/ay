+//! Canonical POSIX / uutils / UnixWin builtin dispatch table shared by `bun_shell_parser`
+//! and `src/uutils` (single source of truth for `Bun.$` and all 67 pure-Rust userland applets).
+//! Kept strictly sorted in ASCII byte order for O(log n) binary search (max 7 probes).
+
+pub const UUTILS_APPLETS: &[&[u8]] = &[
+    b"[", b"awk", b"base64", b"basename", b"bat", b"cat", b"chmod",
+    b"cksum", b"column", b"comm", b"cp", b"cut", b"date", b"df",
+    b"diff", b"dirname", b"dmesg", b"du", b"echo", b"env", b"false",
+    b"find", b"free", b"grep", b"head", b"hexdump", b"hostname", b"id",
+    b"jq", b"ln", b"ls", b"lscpu", b"mkdir", b"mktemp", b"mv",
+    b"nl", b"nproc", b"paste", b"printf", b"ps", b"pwd", b"readlink",
+    b"realpath", b"rev", b"rm", b"rmdir", b"sed", b"seq", b"sh",
+    b"sha256sum", b"sleep", b"sort", b"stat", b"sysctl", b"tac", b"tail",
+    b"tee", b"test", b"tokei", b"touch", b"tr", b"tree", b"true",
+    b"uname", b"uniq", b"uptime", b"wc", b"which", b"whoami", b"xargs",
+    b"yes",
+];
+
+// Compile-time guard: `binary_search` requires strict ascending order.
+const _: () = {
+    const fn bytes_lt(a: &[u8], b: &[u8]) -> bool {
+        let mut i = 0;
+        let len = if a.len() < b.len() { a.len() } else { b.len() };
+        while i < len {
+            if a[i] != b[i] {
+                return a[i] < b[i];
+            }
+            i += 1;
+        }
+        a.len() < b.len()
+    }
+    let mut idx = 1;
+    while idx < UUTILS_APPLETS.len() {
+        assert!(bytes_lt(UUTILS_APPLETS[idx - 1], UUTILS_APPLETS[idx]));
+        idx += 1;
+    }
+};
+
+#[inline]
+pub fn is_uutils_applet(cmd: &[u8]) -> bool {
+    UUTILS_APPLETS.binary_search(&cmd).is_ok()
+}
