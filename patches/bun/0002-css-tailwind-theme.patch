+//! Native Tailwind CSS v4 `@theme` & Material 3 Expressive token helpers inside `bun_css`
+//! (eliminates duplicate CSS token string builders across `src/ui` and web packages).
+
+/// Canonical Material 3 Expressive baseline tokens emitted as Tailwind CSS v4 `@theme`.
+pub const M3_TAILWIND_V4_THEME: &str = r#"@import "tailwindcss";
+@theme {
+  --color-primary: #6750A4;
+  --color-surface: #0B0D12;
+  --color-on-surface: #F4F6FA;
+  --radius-control: 12px;
+  --spacing-touch-min: 44px;
+}
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after {
+    animation-duration: 0.01ms !important;
+    transition-duration: 0.01ms !important;
+  }
+}
+"#;
+
+/// Check whether a CSS byte slice starts with a Tailwind v4 `@theme` at-rule.
+#[inline]
+pub fn is_tailwind_theme_at_rule(input: &[u8]) -> bool {
+    let trimmed = input.trim_ascii_start();
+    trimmed.len() >= 6
+        && bun_core::strings::eql_case_insensitive_ascii_check_length(&trimmed[..6], b"@theme")
+}
+
+/// Check whether a CSS byte slice starts with an `@import` at-rule (e.g. `@import "tailwindcss";`).
+#[inline]
+pub fn is_tailwind_import_at_rule(input: &[u8]) -> bool {
+    let trimmed = input.trim_ascii_start();
+    trimmed.len() >= 7
+        && bun_core::strings::eql_case_insensitive_ascii_check_length(&trimmed[..7], b"@import")
+}
+
+/// Check whether a CSS byte slice starts with a legacy PostCSS Tailwind v3 `@tailwind` directive
+/// (`@tailwind base/components/utilities;`) that `n2b` migrates to `@import "tailwindcss";`.
+#[inline]
+pub fn is_legacy_postcss_tailwind_v3_rule(input: &[u8]) -> bool {
+    let trimmed = input.trim_ascii_start();
+    trimmed.len() >= 9
+        && bun_core::strings::eql_case_insensitive_ascii_check_length(&trimmed[..9], b"@tailwind")
+}
+
+/// Check whether a CSS byte slice declares a Tailwind v4 `@utility` or `@custom-variant` rule.
+#[inline]
+pub fn is_tailwind_v4_extension_rule(input: &[u8]) -> bool {
+    let trimmed = input.trim_ascii_start();
+    (trimmed.len() >= 8
+        && bun_core::strings::eql_case_insensitive_ascii_check_length(&trimmed[..8], b"@utility"))
+        || (trimmed.len() >= 15
+            && bun_core::strings::eql_case_insensitive_ascii_check_length(
+                &trimmed[..15],
+                b"@custom-variant",
+            ))
+}
